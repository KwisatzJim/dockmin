[Unit]
Description=Dockmin Docker Compose administration
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dockmin
Group=dockmin
WorkingDirectory=/var/lib/dockmin
ExecStart=/opt/dockmin/dockmin --config /etc/dockmin/dockmin.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StateDirectory=dockmin
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dockmin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
